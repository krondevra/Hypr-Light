{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/npu", "cpu", "memory", "temperature", "custom/power-profile", "battery", "tray"],

    "hyprland/workspaces": {
        "format": "{id}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
        },
        "on-click": "activate"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 3
    },

    "memory": {
        "format": " {percentage}%",
        "interval": 3
    },

    "temperature": {
        "critical-threshold": 85,
        "format": " {temperatureC}°C",
        "interval": 3
    },

    "custom/npu": {
        "exec": "~/.config/waybar/scripts/waybar-npu.sh",
        "interval": 5,
        "return-type": "",
        "tooltip": true
    },

    "custom/power-profile": {
        "exec": "~/.config/waybar/scripts/waybar-power-profile.sh",
        "on-click": "~/.config/waybar/scripts/waybar-power-profile.sh --cycle",
        "interval": 5
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "format-charging": " {capacity}%"
    },

    "tray": {
        "spacing": 8
    }
}
