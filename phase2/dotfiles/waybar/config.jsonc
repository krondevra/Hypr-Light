{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["cpu", "memory", "temperature", "custom/gpu", "custom/npu"],
    "modules-right": ["clock", "battery", "bluetooth", "backlight", "network", "tray"],

    "hyprland/workspaces": {
        "format": "{id}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
        },
        "on-click": "activate"
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 3
    },

    "memory": {
        "format": " {percentage}%",
        "interval": 3
    },

    "temperature": {
        "critical-threshold": 85,
        "format": " {temperatureC}°C",
        "interval": 3
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/waybar-gpu.sh",
        "interval": 3,
        "return-type": "json",
        "tooltip": true
    },

    "custom/npu": {
        "exec": "~/.config/waybar/scripts/waybar-npu.sh",
        "interval": 5,
        "return-type": "",
        "tooltip": true
    },

    "clock": {
        "format": "{:%d.%m.%Y %H:%M:%S}",
        "interval": 1
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "format-charging": " {capacity}%",
        "on-click": "~/.config/waybar/scripts/waybar-power-profile.sh --cycle",
        "tooltip-format": "Battery: {capacity}% — click to cycle power profile"
    },

    "bluetooth": {
        "format": " {status}",
        "format-connected": " {device_alias}",
        "format-disabled": "",
        "on-click": "blueman-manager",
        "tooltip-format": "{controller_alias}\t{controller_address}"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },

    "tray": {
        "spacing": 8
    }
}
