{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["cpu", "memory", "temperature", "custom/gpu", "custom/npu"],
    "modules-right": ["battery", "bluetooth", "backlight", "network", "clock", "tray"],

    "hyprland/workspaces": {
        "format": "{id}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
        },
        "on-click": "activate"
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 3
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 3
    },

    "temperature": {
        "critical-threshold": 85,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""],
        "interval": 3
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/waybar-gpu.sh",
        "interval": 3,
        "return-type": "json",
        "tooltip": true
    },

    "custom/npu": {
        "exec": "~/.config/waybar/scripts/waybar-npu.sh",
        "interval": 5,
        "return-type": "json",
        "tooltip": true
    },

    "clock": {
        "format": "{:%d.%m.%Y %H:%M:%S}",
        "interval": 1
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "format-charging": "󰂄 {capacity}%",
        "on-click": "~/.config/waybar/scripts/waybar-power-profile.sh --cycle",
        "tooltip-format": "Battery: {capacity}% — click to cycle power profile"
    },

    "bluetooth": {
        "format": "",
        "format-connected": "",
        "format-disabled": "",
        "format-off": "",
        "format-on": "",
        "format-no-controller": "",
        "on-click": "blueman-manager",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"]
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "",
        "format-linked": "",
        "format-disconnected": "",
        "format-disabled": "",
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected"
    },

    "tray": {
        "spacing": 8
    }
}
